dress,uint256)\":{\"params\":{\"amountIn_\":\"token1 to spend on the buy leg.\",\"arbNonce_\":\"Signal nonce from the reactive contract.\",\"poolBuy_\":\"Pool where token0 is cheap.\",\"poolSell_\":\"Pool where token0 is expensive.\",\"reactive_\":\"GapHunterReactive's address (injected by the proxy).\"}},\"pay(uint256)\":{\"details\":\"Make sure to check the msg.sender.\",\"params\":{\"amount_\":\"Amount owed due to reactive transactions and/or callbacks.\"}}},\"title\":\"GapHunterExecutor\",\"version\":1},\"userdoc\":{\"errors\":{\"CallbackNotAuthorized(address,address)\":[{\"notice\":\"Indicates that the callback sender is not authorized to perform the requested action.\"}],\"InsufficientFunds(uint256,uint256)\":[{\"notice\":\"Indicates that there aren't sufficient funds to pay the required amount.\"}],\"NotAuthorized(address,address)\":[{\"notice\":\"Indicates that the caller is not authorized to perform the requested action.\"}],\"TransferFailed()\":[{\"notice\":\"Indicates that the payment to the service provider has failed.\"}]},\"kind\":\"user\",\"methods\":{\"_CALLBACK_SENDER()\":{\"notice\":\"Address of the reactive contract allowed to send callbacks.\"},\"_SERVICE_PROVIDER()\":{\"notice\":\"Service provider contract allowed to request payments.\"},\"arbsExecuted()\":{\"notice\":\"How many arbitrages have executed.\"},\"cooldownSeconds()\":{\"notice\":\"Minimum seconds between executed arbitrages (timestamp-based,         per the Base Sepolia guidance to not count blocks there).\"},\"executeArb(address,uint256,address,address,uint256)\":{\"notice\":\"Callback entry point. The callback proxy overwrites the first         argument with the reactive contract's address.\"},\"lastExecAt()\":{\"notice\":\"Timestamp of the last executed arbitrage.\"},\"lastNonce()\":{\"notice\":\"Last accepted callback nonce (replay protection).\"},\"owner()\":{\"notice\":\"Contract deployer.\"},\"pay(uint256)\":{\"notice\":\"Method called by the system contract and/or proxies when payment is due.\"},\"rescue(address,address,uint256)\":{\"notice\":\"Owner rescue for any token held by the executor (inventory/profits).\"},\"totalProfit()\":{\"notice\":\"Cumulative arbitrage profit, denominated in token1.\"},\"withdrawNative(address,uint256)\":{\"notice\":\"Owner withdrawal of native funds (used to pay callback debt).\"}},\"notice\":\"Destination-chain half of GapHunter (deployed on Base Sepolia).         Receives callbacks from GapHunterReactive and atomically arbitrages         two Uniswap V2 pools for the same pair: buy token0 with token1 on         the cheap pool, sell token0 for token1 on the expensive pool, keep         the difference. The executor trades its own inventory, funded by         the owner; profits accumulate in token1 and are owner-withdrawable.\",\"version\":1}},\"settings\":{\"compilationTarget\":{\"src/GapHunterExecutor.sol\":\"GapHunterExecutor\"},\"evmVersion\":\"osaka\",\"libraries\":{},\"metadata\":{\"bytecodeHash\":\"ipfs\"},\"optimizer\":{\"enabled\":true,\"runs\":200},\"remappings\":[\":@openzeppelin/contracts/=lib/openzeppelin-contracts/contracts/\",\":@reactive/src/=lib/reactive-lib-omni/src/\",\":erc4626-tests/=lib/openzeppelin-contracts/lib/erc4626-tests/\",\":forge-std/=lib/forge-std/src/\",\":halmos-cheatcodes/=lib/openzeppelin-contracts/lib/halmos-cheatcodes/src/\",\":openzeppelin-contracts/=lib/openzeppelin-contracts/\",\":reactive-lib-omni/=lib/reactive-lib-omni/src/\",\":v2-core/=lib/v2-core/contracts/\",\":v2-periphery/=lib/v2-periphery/contracts/\"],\"viaIR\":true},\"sources\":{\"lib/reactive-lib-omni/src/base/AbstractCallback.sol\":{\"keccak256\":\"0xcf18b05a3faf0ad2d9c2d9b57ee60355de9e868ea430eec2b1f18adc7ff4eda8\",\"license\":\"UNLICENSED\",\"urls\":[\"bzz-raw://05c901820b11e1fb27f421fc0dcaf9eb44f0dcba8a015b14b5a86d214bb5f597\",\"dweb:/ipfs/QmTB1tHXdczUJziSkxExkfycaWvUPcxEqKftvULVcR2gjB\"]},\"lib/reactive-lib-omni/src/base/AbstractPayer.sol\":{\"keccak256\":\"0xef794f0374d49bfc919613c241e5e12a182457fc